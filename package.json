{
  "name": "dsh-workspace-plus",
  "version": "0.3.2",
  "description": "把侧栏工作区的「＋」改成自定义工作区创建框：输入名称即可自动创建同名文件夹并新建工作区，不再弹出文件夹选择器。",
  "type": "module",
  "license": "MIT",
  "author": "ColdRainLab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColdRainLab/dsh-workspace-plus.git"
  },
  "homepage": "https://github.com/ColdRainLab/dsh-workspace-plus#readme",
  "bugs": {
    "url": "https://github.com/ColdRainLab/dsh-workspace-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}